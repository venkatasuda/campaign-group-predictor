# Copy to .env and adjust. All variables are optional - defaults are in src/config.py
APP_NAME="Campaign Group Predictor API"
API_VERSION="1.0.0"
LOG_LEVEL="INFO"

# Path to the trained pipeline artifact produced by `make train`
MODEL_PATH="artifacts/model.pkl"

# Which predictor implementation to instantiate: "sklearn_pipeline" | "majority_class"
MODEL_TYPE="sklearn_pipeline"

# If the artifact cannot be loaded, fall back to the majority-class baseline instead of
# refusing to start.
#
# The code default is FALSE - the service fails closed. This file sets it true because a
# fresh clone has no trained model (artifacts/*.pkl is gitignored) and a developer wants the
# API to come up regardless. That is a deliberate local opt-in, not the production posture.
#
# NEVER set this true in production. It was the direct cause of a deployed service serving
# majority-class predictions through three consecutive "successful" deploys while /health
# reported only "degraded".
ALLOW_BASELINE_FALLBACK=true

# Frontend -> backend
API_BASE_URL="http://localhost:8000"

# ---- Cost-sensitive decision layer ----
# The API returns the action minimising expected cost, not just the most likely class.
# These are BUSINESS inputs - confirm them with the marketing team before production.
ENABLE_DECISION_LAYER=true

# Average cost of running one campaign
CAMPAIGN_SPEND=1.0

# Average net profit when the correct group is targeted
PROFIT_IF_CORRECT=1.0

# Share of the profit charged for declining a campaign that would have paid off (0-1)
OPPORTUNITY_WEIGHT=0.5

# Expected-cost gap below which a decision is flagged for human review
DECISION_REVIEW_MARGIN=0.05

# Minimum predicted probability required to decide a campaign automatically. Below it, the
# response is flagged `review_required` regardless of the cost margin.
#
# 0.60 is NOT a round number chosen for convenience. It was selected on the held-out
# calibration split by a stated rule - best accuracy subject to coverage >= 30% - then
# frozen and applied to the test set once, where it delivered 71.6% accuracy on the 34.8%
# of campaigns above it (selected at 73.9% on calibration, so it generalised).
#
# It is a FITTED PARAMETER tied to this specific artifact. Re-derive it from
# findings.json["automation_gate"]["threshold"] after every retrain. A threshold chosen for
# one champion is meaningless for another, which is why the code default is 0.0 (disabled)
# rather than this value hard-coded.
AUTOMATION_CONFIDENCE_THRESHOLD=0.60

# Fraction of "do not run" recommendations overridden so the outcome is still observed.
# Without this, declining a campaign censors the data that trains the next model.
#
# The code default is 0.0 - OFF. Exploration spends real budget on deliberately sub-optimal
# campaigns. That can be an excellent investment (it is what makes inverse-propensity
# evaluation of future models possible at all), but it is not a config default's decision:
# shipping 0.05 quietly commits a marketing team to misallocating one campaign in twenty.
#
# Set it above zero only after the business has agreed to the trade-off. See
# docs/validation_plan.md section 5.1.
EXPLORATION_RATE=0.0

DECISION_CURRENCY="EUR"

# ---- Security ----
# Comma-separated CORS origins. "*" is a development convenience; set this to the
# deployed frontend URL in production (credentials are disabled while it is "*").
ALLOWED_ORIGINS="*"
